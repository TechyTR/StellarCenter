#!/bin/sh

set -e

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

GRADLE_VERSION="9.3.1"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
GRADLE_DIST="$GRADLE_USER_HOME/wrapper/dists/gradle-$GRADLE_VERSION"
GRADLE_DIR="$GRADLE_DIST/gradle-$GRADLE_VERSION"
GRADLE_ZIP="$GRADLE_DIST/gradle-$GRADLE_VERSION-bin.zip"

if [ ! -x "$GRADLE_DIR/bin/gradle" ]; then
    mkdir -p "$GRADLE_DIST"

    if [ ! -f "$GRADLE_ZIP" ]; then
        echo "Downloading Gradle $GRADLE_VERSION..."

        curl -fL \
            --retry 3 \
            --connect-timeout 15 \
            -o "$GRADLE_ZIP" \
            "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
    fi

    echo "Installing Gradle $GRADLE_VERSION..."

    TMP_DIR="$GRADLE_DIST/.tmp"

    rm -rf "$TMP_DIR"
    mkdir -p "$TMP_DIR"

    unzip -q "$GRADLE_ZIP" -d "$TMP_DIR"

    rm -rf "$GRADLE_DIR"

    mv "$TMP_DIR/gradle-$GRADLE_VERSION" "$GRADLE_DIR"

    rm -rf "$TMP_DIR"
fi

exec "$GRADLE_DIR/bin/gradle" \
    --project-dir "$APP_HOME" \
    "$@"
